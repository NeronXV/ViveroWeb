# Copia este archivo localmente como .env.local.
# Nunca introduzcas una clave service_role en el cliente web.
# Las variables VITE_* terminan dentro del bundle público.
# La seguridad depende de Auth, RLS y RPC, no de ocultar la clave pública.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-public-publishable-key
